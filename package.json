{
  "name": "tagbrush",
  "version": "1.2.0",
  "description": "A tiny, no-build CSS library that makes plain semantic HTML look clean and modern. Dark mode built in, themeable with CSS variables.",
  "keywords": [
    "css",
    "classless",
    "css-framework",
    "semantic-html",
    "dark-mode",
    "astro",
    "nextjs",
    "react",
    "vue",
    "nuxt",
    "angular",
    "svelte",
    "web-components",
    "shadow-dom",
    "minimal",
    "markdown",
    "llm",
    "ai-agents",
    "llms-txt",
    "accessible"
  ],
  "homepage": "https://kovirlabs.github.io/tagbrush/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kovirlabs/tagbrush.git"
  },
  "bugs": "https://github.com/kovirlabs/tagbrush/issues",
  "license": "Apache-2.0",
  "style": "tagbrush.css",
  "exports": {
    ".": "./tagbrush.css",
    "./min": "./tagbrush.min.css",
    "./scoped": "./tagbrush.scoped.css",
    "./scoped.min": "./tagbrush.scoped.min.css",
    "./shadow": "./tagbrush.shadow.css",
    "./shadow.min": "./tagbrush.shadow.min.css",
    "./*.css": "./*.css",
    "./package.json": "./package.json"
  },
  "files": [
    "tagbrush.css",
    "tagbrush.min.css",
    "tagbrush.scoped.css",
    "tagbrush.scoped.min.css",
    "tagbrush.shadow.css",
    "tagbrush.shadow.min.css",
    "llms.txt",
    "llms-full.txt",
    "llms/",
    "ai/",
    "bin/"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "playwright test",
    "test:update": "playwright test --update-snapshots",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "gpt-tokenizer": "^4.1.0",
    "lightningcss": "^1.33.0"
  },
  "bin": {
    "tagbrush": "bin/tagbrush.mjs"
  }
}
