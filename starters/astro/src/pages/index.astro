---
import Base from '../layouts/Base.astro';
import { posts } from '../posts.js';
---
<Base>
  <h1>Welcome</h1>
  <p>This site is built with <a href="https://astro.build">Astro</a> and styled by <a href="https://github.com/kovirlabs/tagbrush">TagBrush.css</a>. The templates use plain HTML with no classes.</p>
  <section>
    <h2>Latest posts</h2>
    {posts.map((post) => (
      <article>
        <h3><a href={post.url}>{post.frontmatter.title}</a></h3>
        <p>{post.frontmatter.description}</p>
      </article>
    ))}
  </section>
</Base>
