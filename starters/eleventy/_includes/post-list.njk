{% for post in posts %}
<article>
  <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
  <p><small><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time></small></p>
  {% if post.data.description %}<p>{{ post.data.description }}</p>{% endif %}
</article>
{% endfor %}
