<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} – {% endif %}My site</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tagbrush@2/tagbrush.min.css">
</head>
<body>
  <header>
    <nav aria-label="Main">
      <strong><a href="/">My site</a></strong>
      <ul>
        <li><a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>Home</a></li>
        <li><a href="/posts/"{% if page.url == "/posts/" %} aria-current="page"{% endif %}>Posts</a></li>
      </ul>
    </nav>
  </header>
  <main>
    {{ content | safe }}
  </main>
  <footer>
    <p>© My site</p>
  </footer>
</body>
</html>
